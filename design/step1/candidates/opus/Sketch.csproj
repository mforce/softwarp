<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Factory</RootNamespace>
    <AssemblyName>factory</AssemblyName>
    <StartupObject>Factory.Cli</StartupObject>
    <!-- Sketch only: stub bodies leave primary-constructor parameters unread. Remove once bodies exist. -->
    <NoWarn>$(NoWarn);CS9113</NoWarn>
  </PropertyGroup>

</Project>
