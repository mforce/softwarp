<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>factory</AssemblyName>
    <RootNamespace>Factory</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CS9113 (primary-constructor parameter unread): bodies throw NotImplementedException in this sketch. Drop once bodies exist. -->
    <NoWarn>CS9113</NoWarn>
  </PropertyGroup>

</Project>
